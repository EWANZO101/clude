[Unit]
Description=OPS Mobile store (opsphone-store.opslabsystems.cloud)
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/opsphone-store
ExecStart=/opt/opsphone-store/venv/bin/gunicorn -w 3 -b 127.0.0.1:5121 --access-logfile - app:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
