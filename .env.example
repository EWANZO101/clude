# Flask session/cookie signing key
SECRET_KEY=change-me

# Optional: override the default sqlite database (instance/xonsight.db)
DATABASE_URL=

# How long an active recorder is shown as "live" without a fresh sync before
# it's dropped from the Live page (seconds).
RECORDER_STALE_SECONDS=30

# Shown in video metadata overlays and sent to the AI features below.
AGENCY_NAME=

# Enables Draft One / Brief One / Axon Assistant analogs (report drafting,
# video briefs, the ops assistant chat + BOLO drafting). Leave blank and
# those features show "not configured" instead of erroring. Get a key at
# https://console.anthropic.com/.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# Optional - enables a real hCaptcha widget on the public Community Request
# submission form (/r/<code>). Get free keys at https://www.hcaptcha.com/.
# Leave blank and the form falls back to a built-in math challenge instead.
HCAPTCHA_SITE_KEY=
HCAPTCHA_SECRET_KEY=

# Used to build clickable links in Discord notifications. No trailing slash.
PORTAL_PUBLIC_URL=

# Multi-tenancy (xonsight/tenancy.py): a scoped MySQL account used only to provision/manage each
# community's own database (xonsight_<slug>) and MySQL user - never used for the control-plane DB
# itself, which stays this app's normal SQLite file. Create it once:
#   CREATE USER 'xonsight_provisioner'@'127.0.0.1' IDENTIFIED BY '...';
#   GRANT CREATE USER ON *.* TO 'xonsight_provisioner'@'127.0.0.1';
#   GRANT ALL PRIVILEGES ON `xonsight_%`.* TO 'xonsight_provisioner'@'127.0.0.1' WITH GRANT OPTION;
# Leave MYSQL_PROVISIONER_PASSWORD blank to disable multi-tenancy (community creation errors clearly instead).
# Required for the webhook API to accept anything at all: every FiveM resource authenticates with a
# per-community X-XonSight-Token (see xonsight/webhooks.py), issued when a community is created - there
# is no shared-secret fallback.
MYSQL_PROVISIONER_HOST=127.0.0.1
MYSQL_PROVISIONER_PORT=3306
MYSQL_PROVISIONER_USER=xonsight_provisioner
MYSQL_PROVISIONER_PASSWORD=
