[Unit]
Description=Cioda's Commission Site
After=network.target

[Service]
User=root
WorkingDirectory=/root/cioda-commissions
Environment="PATH=/root/venv/bin"
ExecStart=/root/venv/bin/gunicorn -w 4 -b 127.0.0.1:5025 --timeout 120 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
