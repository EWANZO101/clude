# /etc/nginx/sites-available/cioda-commissions
#
# SETUP STEPS:
#   1. Copy this file to nginx:
#        sudo cp cioda-commissions.nginx /etc/nginx/sites-available/cioda-commissions
#
#   2. Enable it:
#        sudo ln -s /etc/nginx/sites-available/cioda-commissions /etc/nginx/sites-enabled/cioda-commissions
#
#   3. Test the config:
#        sudo nginx -t
#
#   4. Reload nginx:
#        sudo systemctl reload nginx
#
#   5. Install gunicorn (if not already):
#        pip install gunicorn
#
#   6. Run the app (use this instead of python3 app.py):
#        cd ~/cioda-commissions
#        source venv/bin/activate
#        gunicorn -w 4 -b 127.0.0.1:5025 --timeout 120 app:app
#
#   7. Get SSL cert (free via Let's Encrypt):
#        sudo apt install certbot python3-certbot-nginx -y
#        sudo certbot --nginx -d order.ciodrawz.space
#
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    listen [::]:80;
    server_name order.ciodrawz.space;

    # Redirect all HTTP → HTTPS
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name order.ciodrawz.space;

    # ── SSL certificates (filled in automatically by certbot) ──
    # If doing it manually, point these to your cert files:
    # ssl_certificate     /etc/letsencrypt/live/order.ciodrawz.space/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/order.ciodrawz.space/privkey.pem;

    # ── SSL hardening ──
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    # ── Security headers ──
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Logging ──
    access_log /var/log/nginx/cioda-commissions.access.log;
    error_log  /var/log/nginx/cioda-commissions.error.log;

    # ── Max upload size ── nginx defaults to 1M if this is missing, which
    # silently 413s any real photo (gallery uploads, reference images).
    client_max_body_size 25M;

    # ── Static files served directly by nginx (faster) ──
    location /static/ {
        alias /root/cioda-commissions/static/;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Everything else goes to gunicorn ──
    location / {
        proxy_pass         http://127.0.0.1:5025;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_connect_timeout 60s;
        proxy_send_timeout    120s;
        proxy_read_timeout    120s;
    }
}
