{
  "expo": {
    "name": "Cioda",
    "slug": "cioda-commissions",
    "scheme": "cioda",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F0F11",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "space.ciodrawz.commissions",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "space.ciodrawz.commissions",
      "adaptiveIcon": {
        "backgroundColor": "#0F0F11",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose reference images for your commission, or artwork to share with customers.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#0F0F11"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "fb5a7145-e31c-4a82-9739-df0ba4f8740a"
      }
    },
    "owner": "opslabs"
  }
}
