[Unit]
Description=OpsLabs Commission (Gunicorn)
After=network.target

[Service]
User=root
WorkingDirectory=/root/opslabs-commission
ExecStart=/root/opslabs-commission/venv/bin/gunicorn -w 4 -b 127.0.0.1:6201 --timeout 120 app:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
