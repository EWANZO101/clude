<?xml version="1.0" encoding="UTF-8"?>
<!--
  Product.wxs - StockTool Kiosk MSI.

  Authored natively for the modern WiX Toolset CLI (v4/v5/v6+, whatever
  "wix.exe build" reports as its version - the *schema* namespace below
  has stayed http://wixtoolset.org/schemas/v4/wxs since the v4 rewrite
  even as the CLI tool's own version number has kept climbing, so this
  targets that schema directly rather than guessing at a CLI version).

  This intentionally does NOT use the old WiX v3 candle.exe/light.exe
  toolchain or v3's <Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  schema - <Product>/<Package> were merged into one <Package> element,
  Win64="yes" on <Component> was removed in favour of -arch on the build
  command, and <UIRef> was replaced by the ui: namespace's <ui:WixUI>.
  Trying to build this file's markup with candle/light (or trying to
  regex-patch a v3 file into looking like this at build time) will not
  work - author for one schema version and stick to it.

  Build (from this installer\ directory):
      wix.exe extension add WixToolset.UI.wixext         (one-time)
      wix.exe build Product.wxs -arch x64 -ext WixToolset.UI.wixext ^
          -d ProductVersion=X.Y.Z -d NssmSrc=path\to\nssm.exe ^
          -o StockToolKiosk.msi

  build.ps1 in the parent folder does all of the above for you, plus the
  PyInstaller build that has to happen first (this file references
  dist\StockToolKiosk.exe as a source - it doesn't build it).

  UPGRADE CODE - DO NOT CHANGE. Keeping this GUID constant across every
  release is what lets MajorUpgrade below detect "this is a newer version
  of the same product" and cleanly replace the old install in place,
  rather than sitting side by side with it or refusing to install. Only
  the per-release ProductCode (auto-generated by leaving Package/@Id as
  "*", the default when it's omitted) changes between builds.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <?ifndef ProductVersion?>
    <?error ProductVersion must be passed with -d ProductVersion=X.Y.Z (build.ps1 does this from version.py) ?>
  <?endif?>
  <?ifndef NssmSrc?>
    <?error NssmSrc must be passed with -d NssmSrc=path\to\nssm.exe (build.ps1 does this) ?>
  <?endif?>

  <Package Name="StockTool Kiosk"
           Language="1033"
           Version="$(var.ProductVersion)"
           Manufacturer="OpsLab Systems"
           UpgradeCode="1915E8F3-4602-4CF8-8038-BA346FAD23CA"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <SummaryInformation Description="StockTool Kiosk $(var.ProductVersion) Setup" />

    <!-- Refuses to install an older or equal version over a newer one
         already present; auto-uninstalls the old version's files before
         installing the new ones otherwise. This is what makes shipping a
         new .msi for each release actually work as an "update" rather
         than a broken parallel install. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of StockTool Kiosk is already installed."
                  Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Personalized-install properties - see stocktoolsetup.opslabsystems.cloud's
         /provision route, which builds a per-customer MSI passing these
         via: msiexec /i StockToolKiosk.msi PROVISION_TOKEN=... PROVISION_USERNAME=...
         Left blank (the normal, non-personalized download), the exit-dialog
         "Pair now" checkbox is what runs setup instead - see the UI section below.
         Secure="yes" is required for a property to survive into a deferred
         custom action, which SilentProvision (below) is. -->
    <Property Id="PROVISION_TOKEN" Secure="yes" />
    <Property Id="PROVISION_USERNAME" Secure="yes" />
    <Property Id="PROVISION_BADGECODE" Secure="yes" />
    <Property Id="PROVISION_ROLE" Value="admin" Secure="yes" />

    <Property Id="ARPPRODUCTICON" Value="StockToolIcon.exe" />
    <Icon Id="StockToolIcon.exe" SourceFile="icon.ico" />

    <Feature Id="MainFeature" Title="StockTool Kiosk" Level="1">
      <ComponentGroupRef Id="AppFiles" />
      <ComponentRef Id="StartMenuShortcuts" />
    </Feature>

    <!-- StandardDirectory replaces v3's manual
         <Directory Id="TARGETDIR" Name="SourceDir"><Directory Id="ProgramFiles64Folder">...
         boilerplate - the well-known folder IDs are now roots you can
         reference directly. -arch x64 on the build command is what makes
         ProgramFiles64Folder resolve to Program Files and not
         Program Files (x86). -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="StockTool Kiosk" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="StockTool Kiosk" />
    </StandardDirectory>

    <ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
      <Component Id="MainExe" Guid="B9046755-9CBC-4273-9849-C963B8D85CA2">
        <File Id="StockToolKioskExe" Source="..\dist\StockToolKiosk.exe" KeyPath="yes" />
      </Component>
      <Component Id="SetupWizardScript" Guid="CCC71C7B-7EB2-4D1A-AEC6-752B1405DC39">
        <File Id="SetupWizardPs1" Source="SetupWizard.ps1" KeyPath="yes" />
      </Component>
      <Component Id="NssmExe" Guid="B6758B3D-2D3E-4930-B2AD-3E453BACEBBD">
        <!--
          nssm.exe is NOT built by this project: download the win64
          build from https://nssm.cc/download and pass its path as
          -d NssmSrc=... (build.ps1's -NssmPath parameter does this for
          you). NSSM is public domain, no licensing concern bundling it.
          Used by SetupWizard.ps1 to register StockToolKiosk.exe as the
          "StockToolKioskAPI" Windows service (running with the service
          flag; see main.py's run_service()).
        -->
        <File Id="NssmExeFile" Source="$(var.NssmSrc)" KeyPath="yes" />
      </Component>
      <Component Id="LicenseTxt" Guid="*">
        <File Source="..\license.txt" KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <Component Id="StartMenuShortcuts" Directory="AppProgramMenuFolder" Guid="*">
      <!-- SetupWizard.ps1 also creates its own copies of these four
           shortcuts at runtime (see its New-Shortcuts function) so that
           re-running setup after a manual file copy still works - these
           MSI-managed ones are what makes "msiexec /x" cleanly remove
           them again, which the runtime-created ones alone wouldn't
           guarantee. -->
      <Shortcut Id="OpenShortcut" Name="StockTool Kiosk"
                Target="[INSTALLFOLDER]StockToolKiosk.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="SetupShortcut" Name="StockTool Kiosk Setup"
                Target="[SystemFolder]WindowsPowerShell\v1.0\powershell.exe"
                Arguments="-NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]SetupWizard.ps1&quot;"
                WorkingDirectory="INSTALLFOLDER" />
      <Shortcut Id="UninstallShortcut" Name="Uninstall StockTool Kiosk"
                Target="[System64Folder]msiexec.exe" Arguments="/x [ProductCode]" />
      <RemoveFolder Id="RemoveAppProgramMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\OpsLabSystems\StockToolKiosk"
                      Name="installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Post-install: register the service.
         Two paths, mutually exclusive by whether PROVISION_TOKEN was
         passed on the command line (a personalized MSI from
         stocktoolsetup.opslabsystems.cloud's /provision route):

           A) Personalized: silently provision plus register the
              service, no prompts at all, for the "download a build
              with your account already baked in" flow.
           B) Plain download: nothing runs automatically here; the exit
              dialog offers a "Pair / set up now" checkbox that
              launches the exe with its pair flag (see main.py's
              argument parser), which itself registers the service on
              success (see main.py's run_pair function). Running
              SetupWizard.ps1 unattended for a not yet paired install
              would start the service in local mode with no admin
              account yet, which is more confusing than just leaving it
              off until pairing completes.
    -->
    <CustomAction Id="SilentProvision" Directory="INSTALLFOLDER" Impersonate="no" Execute="deferred" Return="check"
                  ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]StockToolKiosk.exe&quot; --provision --installation-token &quot;[PROVISION_TOKEN]&quot; --username &quot;[PROVISION_USERNAME]&quot; --badge-code &quot;[PROVISION_BADGECODE]&quot; --role &quot;[PROVISION_ROLE]&quot; &amp;&amp; powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;[INSTALLFOLDER]SetupWizard.ps1&quot; -Silent" />

    <InstallExecuteSequence>
      <Custom Action="SilentProvision" After="InstallFiles" Condition="PROVISION_TOKEN AND NOT Installed" />
    </InstallExecuteSequence>

    <!-- UI: standard install-dir wizard plus a "pair now" launch checkbox
         on the exit dialog for the plain (non-personalized) path. Needs
         WixToolset.UI.wixext at build time (-ext WixToolset.UI.wixext)
         and at install time (the extension's merge module ships inside
         the built MSI automatically - nothing extra for the end user
         to install). -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <CustomAction Id="LaunchPairing" Directory="INSTALLFOLDER" Return="asyncNoWait"
                  ExeCommand="&quot;[INSTALLFOLDER]StockToolKiosk.exe&quot; --pair" />
    <UI>
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchPairing"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT PROVISION_TOKEN" />
    </UI>
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT"
              Value="Set up StockTool Kiosk now (pair account / configure access)" />
    <WixVariable Id="WixUIExitDialogOptionalCheckBox" Value="1" />

  </Package>
</Wix>
