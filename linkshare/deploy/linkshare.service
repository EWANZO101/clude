[Unit]
Description=LinkShare - temporary media sharing
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/linkshare
Environment="EXPIRE_HOURS=12"
Environment="MAX_UPLOAD_MB=500"
Environment="SECRET_KEY=CHANGE_ME_TO_RANDOM_STRING"
ExecStart=/opt/linkshare/venv/bin/gunicorn -w 1 --worker-class gthread --threads 4 -b 127.0.0.1:8801 --timeout 300 app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
