[Unit]
Description=Email → Discord Bot (cbot)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/cbot
ExecStart=/root/cbot/venv/bin/python /root/cbot/email_discord_bot.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
