[Unit]
Description=OpsLabs SaaS Platform (Gunicorn)
After=network.target postgresql.service

[Service]
User=root
WorkingDirectory=/root/opslabs-platform
ExecStart=/root/opslabs-platform/venv/bin/gunicorn -w 4 -b 0.0.0.0:6200 --timeout 120 wsgi:app
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
